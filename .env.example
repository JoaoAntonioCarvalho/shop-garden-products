# Copie para .env e preencha. Nada aqui com prefixo NEXT_PUBLIC_ pode ser segredo.

# Conexão com o PostgreSQL. O valor abaixo corresponde ao docker-compose.yml.
DATABASE_URL="postgresql://netshopgarden:netshopgarden@localhost:5432/netshopgarden?schema=public"
# Banco usado pelos testes que precisam de Postgres (criado pelo docker/postgres-init.sql).
DATABASE_URL_TEST="postgresql://netshopgarden:netshopgarden@localhost:5432/netshopgarden_test?schema=public"

# Segredo do Auth.js (sessão JWT) e das assinaturas internas. Gere com: openssl rand -base64 32
AUTH_SECRET=

# URL pública da aplicação, sem barra final. Usada em links de e-mail, canonical e sitemap.
APP_URL=http://localhost:3100

# Usuário administrador criado pelo seed.
ADMIN_EMAIL=admin@netshopgarden.com.br
ADMIN_PASSWORD=          # senha inicial do admin criada pelo seed

# SMTP. Em desenvolvimento aponta para o Mailpit (interface em http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Remetente dos e-mails transacionais.
EMAIL_FROM="Net Shop Garden <contato@netshopgarden.com.br>"

# Armazenamento de imagens: local grava em ./uploads; s3 usa qualquer serviço compatível (S3, R2, MinIO).
STORAGE_DRIVER=local     # local | s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Provedores. Nesta versão só existe o modo simulado.
PAYMENT_PROVIDER=mock    # mock | (futuro: mercadopago, pagarme, stripe...)
SHIPPING_PROVIDER=mock   # mock (tabela do painel) | correios | jadlog | correios,jadlog

# Comum às transportadoras (obrigatório quando SHIPPING_PROVIDER não é mock)
SHIPPING_ORIGIN_CEP=           # CEP de onde os pedidos saem
SHIPPING_HANDLING_DAYS=1       # dias úteis para separar e postar, somados ao prazo

# Correios (só com "correios" em SHIPPING_PROVIDER). Exige contrato com os Correios.
CORREIOS_USER=                 # usuário do Meu Correios (idCorreios)
CORREIOS_ACCESS_CODE=          # código de acesso às APIs, gerado no portal Correios API (não é a senha)
CORREIOS_POSTING_CARD=         # número do cartão de postagem
CORREIOS_CONTRACT=             # número do contrato (opcional, para o preço do contrato)
CORREIOS_DR=                   # número da DR/SE do contrato (obrigatório se informar o contrato)
CORREIOS_BASE_URL=https://api.correios.com.br   # homologação: https://apihom.correios.com.br
CORREIOS_SERVICE_ECONOMY=03298 # código do PAC do contrato
CORREIOS_SERVICE_EXPRESS=03220 # código do SEDEX do contrato

# Jadlog (só com "jadlog" em SHIPPING_PROVIDER). O token é pedido à franquia Jadlog que atende a loja.
JADLOG_TOKEN=                  # token da API
JADLOG_CNPJ=                   # CNPJ do tomador do serviço
JADLOG_ACCOUNT=                # conta corrente Jadlog (se for correntista)
JADLOG_CONTRACT=               # contrato (só se a Jadlog tiver passado)
JADLOG_MODALITY_ECONOMY=3      # modalidade do envio econômico (3 = .Package, 4 = Rodoviário)
JADLOG_MODALITY_EXPRESS=       # modalidade do envio expresso (0 = Expresso); vazio = a Jadlog não cota o expresso

# Mostra os botões de "simular pagamento" na confirmação do pedido. Ignorado em produção.
ENABLE_PAYMENT_SIMULATOR=true   # mostra botões de "simular pagamento" fora de produção

# Segredo exigido pelas tarefas agendadas em /api/cron/[tarefa]. Gere com: openssl rand -hex 32
CRON_SECRET=

# Analytics. Vazios = eventos só no console em desenvolvimento. Também editáveis no admin.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Autopreenchimento de endereço pelo ViaCEP. Com false, o cliente preenche manualmente.
VIACEP_ENABLED=true
