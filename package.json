{
  "name": "netshopgarden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "vercel-build": "prisma migrate deploy && next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:seed:essentials": "tsx prisma/seed/essentials.ts",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "db:studio": "prisma studio",
    "images:placeholders": "tsx scripts/generate-placeholders.ts",
    "import:legacy": "tsx --require ./scripts/allow-server-only.cjs scripts/import-legacy.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tanstack/react-table": "^9.2.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
